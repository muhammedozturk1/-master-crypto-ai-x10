# Çalışma modu: BACKTEST | PAPER | SIGNAL_ONLY | MANUAL_APPROVAL | AUTONOMOUS_LIVE
MODE=PAPER

# Bybit – demo hesap anahtarları (Bybit > Demo Trading > API). Para çekme yetkisi VERMEYİN.
BYBIT_DEMO=true
MARKET_TYPE=linear
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Canlı mod için iki şart: MODE=AUTONOMOUS_LIVE ve aşağıdaki onay, ayrıca BYBIT_DEMO=false
LIVE_TRADING_CONFIRMED=false

DATABASE_URL=sqlite:///./data/x10.db

# Paneldeki yazma işlemleri (bot aç/kapat, acil durdurma) için uzun, rastgele bir değer
DASHBOARD_TOKEN=

# Risk ayarları kodda kilitli tavanların üstüne çıkamaz (bkz. app/config.py)
RISK__LEVERAGE=2
RISK__RISK_PER_TRADE_PCT=0.5

# Telegram bildirimleri (BotFather'dan bot anahtarı ve sohbet kimliği); boşsa kapalı
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Giriş emri: limit (PostOnly, plan fiyatı, maker komisyonu; 5m:2 dk, 15m:5 dk, 1h:15 dk bekler) | market
ENTRY_ORDER_TYPE=limit
